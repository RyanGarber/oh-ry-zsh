# Houston — adapted from the Shiki theme.
# Micro separates syntax groups and editor chrome; colors are mapped to its closest groups.

# Syntax
color-link default "#eef0f9,#17191e"
color-link comment "italic #858b98,#17191e"
color-link comment.bright "italic #545864,#17191e"
color-link identifier "#4bf3c8,#17191e"
color-link identifier.var "#4bf3c8,#17191e"
color-link identifier.class "#acafff,#17191e"
color-link identifier.macro "#acafff,#17191e"
color-link constant "#ffd493,#17191e"
color-link constant.bool "#ffd493,#17191e"
color-link constant.bool.true "#ffd493,#17191e"
color-link constant.bool.false "#ffd493,#17191e"
color-link constant.number "#ffd493,#17191e"
color-link constant.specialChar "#eef0f9,#17191e"
color-link constant.string "#ffd493,#17191e"
color-link constant.string.url "#4bf3c8,#17191e"
color-link statement "#54b9ff,#17191e"
color-link symbol "#eef0f9,#17191e"
color-link symbol.brackets "#eef0f9,#17191e"
color-link symbol.operator "#eef0f9,#17191e"
color-link symbol.tag "#54b9ff,#17191e"
color-link preproc "#54b9ff,#17191e"
color-link preproc.shebang "#00daef,#17191e"
color-link type "#acafff,#17191e"
color-link type.keyword "#54b9ff,#17191e"
color-link special "#00daef,#17191e"
color-link underlined "underline #54b9ff,#17191e"
color-link error "bold #ffffff,#17191e"
color-link todo "bold #ffd493,#17191e"

# Editor chrome
color-link statusline "#eef0f9,#343841"
color-link tabbar "#bfc1c9,#23262d"
color-link indent-char "#343841,#17191e"
color-link line-number "#545864,#17191e"
color-link gutter-error "#f4587e,#23262d"
color-link gutter-warning "#fbc23b,#23262d"
color-link cursor-line "#23262d"
color-link current-line-number "#858b98,#23262d"
color-link color-column "#343841,#17191e"
color-link ignore "#858b98,#17191e"
color-link divider "#343841"
color-link selection "#eef0f9,#3f2b4c"
color-link autocomplete "#d4d4d4,#252526"
color-link autocomplete.inactive "#858b98,#252526"
color-link autocomplete.selected "#ffffff,#062f4a"
color-link message "#eef0f9,#343841"
color-link prompt "#eef0f9,#23262d"
color-link scrollbar "#545864,#17191e"
